class Knapsack {
    static int knapsack(int[] weights, int[] values, int W) {
        int n = weights.length;
        // dp[i][w] = max value using first i items with capacity w
        int[][] dp = new int[n + 1][W + 1];

        for (int i = 1; i <= n; i++) {
            for (int w = 0; w <= W; w++) {
                // Option 1: do NOT include item i
                dp[i][w] = dp[i - 1][w];

                // Option 2: include item i (if it fits)
                if (weights[i - 1] <= w) {
                    int withItem = values[i - 1] + dp[i - 1][w - weights[i - 1]];
                    dp[i][w] = Math.max(dp[i][w], withItem);
                }
            }
        }

        // Traceback to find which items were included
        System.out.print("Selected items: ");
        int w = W;
        for (int i = n; i >= 1; i--) {
            if (dp[i][w] != dp[i - 1][w]) {
                System.out.print("Item " + i + " (" + weights[i-1] + "kg) ");
                w -= weights[i - 1];
            }
        }
        System.out.println();
        return dp[n][W];
    }

    public static void main(String[] args) {
        // B1=5kg/10val, B2=4kg/9val, B3=3kg/6val, B4=2kg/4val
        int[] weights = {5, 4, 3, 2};
        int[] values  = {10, 9, 6, 4};
        int capacity  = 10;

        int maxVal = knapsack(weights, values, capacity);
        System.out.println("Maximum value: " + maxVal);
    }
}
