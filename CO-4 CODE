import java.util.*;

class BellmanFord {
    static int[] bellmanFord(int V, int[][] edges, int src) {
        // edges[i] = {from, to, weight}
        int[] dist = new int[V];
        Arrays.fill(dist, Integer.MAX_VALUE);
        dist[src] = 0;

        // Relax ALL edges V-1 times
        for (int pass = 1; pass <= V - 1; pass++) {
            for (int[] edge : edges) {
                int u = edge[0], v = edge[1], w = edge[2];
                // If u is reachable AND relaxation improves v
                if (dist[u] != Integer.MAX_VALUE && dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                }
            }
        }

        // Extra pass to detect negative cycle
        for (int[] edge : edges) {
            int u = edge[0], v = edge[1], w = edge[2];
            if (dist[u] != Integer.MAX_VALUE && dist[u] + w < dist[v]) {
                System.out.println("NEGATIVE CYCLE DETECTED!");
                return null;
            }
        }

        return dist;
    }

    public static void main(String[] args) {
        // 0=A, 1=B, 2=C, 3=D, 4=E
        int[][] edges = {
            {0, 1, 4},   // A->B, weight 4
            {0, 2, 2},   // A->C, weight 2
            {1, 3, 3},   // B->D, weight 3
            {2, 1, 1},   // C->B, weight 1 (shortcut)
            {2, 3, 5},   // C->D, weight 5
            {3, 4, 2},   // D->E, weight 2
            {1, 4, -1}   // B->E, weight -1 (toll credit)
        };
        int[] dist = bellmanFord(5, edges, 0);
        System.out.println("Shortest dist A to E: " + dist[4]); // 2
    }
}
